# FeedReader Configuration Example
# Copy this file to config.yaml and customize

database:
  # Path to SQLite database file
  path: ./herald.db

ollama:
  # Ollama API base URL (chat models only — see embedding env vars below).
  base_url: http://localhost:11434

  # Security model - Gemma 4 for content safety screening
  security_model: gemma4

  # Curation model - Gemma 4 for interest scoring
  curation_model: gemma4

# Embedding configuration is read from environment variables, not YAML, so a
# single set of variables can drive every app in the ecosystem (memstore,
# herald, …) without duplicating values across config files.
#
#   EMBEDDING_BACKEND   ollama | openai     (default: ollama)
#   EMBEDDING_BASE_URL  embedder host       (default: http://localhost:11434)
#   EMBEDDING_MODEL     model name          (default: nomic-embed-text)
#   EMBEDDING_API_KEY   bearer token        (optional)
#   EMBEDDING_STRICT    true | false        (error vs. truncate on oversize input)
#
# Override just for herald using the HERALD_EMBED_* prefix; those values cascade
# to EMBEDDING_* if unset.
#
# IMPORTANT: changing the embedding model invalidates existing group centroids.
# Stale centroids from the previous model are automatically ignored and rebuild
# as new articles are processed. To force a full rebuild, clear the column:
# UPDATE article_groups SET embedding = NULL;

thresholds:
  # Minimum interest score (0-10) to trigger notification
  interest_score: 8

  # Minimum security score (0-10) to consider article safe
  security_score: 7

preferences:
  # Keywords that indicate interesting topics
  keywords:
    - technology
    - security
    - AI
    - programming

  # Preferred news sources (URLs)
  preferred_sources: []

# Optional: Override default AI prompts (system-wide)
# Leave empty to use embedded defaults
# Prompts use Go template syntax with variables like {{.Title}}, {{.Content}}, etc.
prompts:
  # security: |
  #   Your custom security analysis prompt here...
  #   Available vars: {{.Title}}, {{.Content}}

  # curation: |
  #   Your custom curation prompt here...
  #   Available vars: {{.Title}}, {{.Content}}, {{.Keywords}}

  # summarization: |
  #   Your custom summarization prompt here...
  #   Available vars: {{.Title}}, {{.Content}}

  # group_summary: |
  #   Your custom group summary prompt here...
  #   Available vars: {{.Topic}}, {{.Articles}}

  # related_groups: |
  #   Your custom related groups prompt here...
  #   Available vars: {{.Title}}, {{.Summary}}, {{.Groups}}

# Optional: Override default AI temperatures (system-wide)
# Values between 0.0 (deterministic) and 1.0 (creative)
temperatures:
  security: 0.3       # Conservative for security checks
  curation: 0.5       # Balanced for interest scoring
  summarization: 0.3  # Focused for summaries
  group_summary: 0.5  # Creative for narratives
  related_groups: 0.3 # Precise for group matching
